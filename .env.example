# ─────────────────────────────────────────────────────────────────────────────
# Shopify Multi-Courier Dispatch Platform — Environment Variables
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# NEVER put merchant Shopify tokens or courier API credentials here.
# Merchant credentials are entered through Settings → Integrations in the UI.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────────────────────
# Your Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key — used in browser & SSR clients (safe to expose)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key — SERVER-SIDE ONLY. Bypasses RLS. NEVER use NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# ─── Shopify App ─────────────────────────────────────────────────────────────
# These are the app-level OAuth credentials from your Shopify Partner dashboard.
# They are NOT the per-store merchant access token — that is stored encrypted in DB.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_APP_URL=orders.universesraw.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_orders,write_orders,read_products,read_fulfillments,write_fulfillments

# ─── Credential Encryption ───────────────────────────────────────────────────
# 32-byte key encoded as base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this secret — it protects all encrypted courier credentials in the DB.
ENCRYPTION_KEY=

# ─── Courier API Base URLs ───────────────────────────────────────────────────
# These are base URLs, not credentials. Credentials are entered through the UI.
REDX_API_URL=https://api.redx.com.bd
PATHAO_API_URL=https://api-hermes.pathao.com
STEADFAST_API_URL=https://portal.steadfast.com.bd

# ─── Error Monitoring (optional) ─────────────────────────────────────────────
SENTRY_DSN=
